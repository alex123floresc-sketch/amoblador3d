{
  "name": "amoblador3d",
  "version": "1.0.0",
  "description": "Diseñador de interiores 3D con medidas reales",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "icon": "electron scripts/generate-icon.mjs",
    "models:samples": "node scripts/generate-sample-models.mjs"
  },
  "keywords": [],
  "author": "alex123floresc-sketch",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "pe.edu.unaj.amoblador3d",
    "productName": "Amoblador3D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "fileAssociations": [
      {
        "ext": "amob3d",
        "name": "Proyecto Amoblador3D",
        "description": "Proyecto de Amoblador3D",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Amoblador3D"
    }
  }
}
