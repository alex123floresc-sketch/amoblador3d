<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.edu.unaj</groupId>
  <artifactId>amoblador3d</artifactId>
  <version>2.0.0</version>
  <name>Amoblador3D</name>
  <description>Diseñador de interiores 3D con medidas reales (JavaFX + SQLite)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <javafx.version>21.0.4</javafx.version>
    <main.class>pe.edu.unaj.amoblador3d.FSHFLauncher</main.class>
    <!-- SQLite carga una librería nativa: sin esto, Java 22+ muestra avisos al arrancar -->
    <native.access>--enable-native-access=ALL-UNNAMED</native.access>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <!-- Base de datos SQLite (proyectos y modelos importados) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
    </dependency>
    <!-- JSON: catálogo incluido, modelos glTF y archivos .amob3d -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>
    <!-- PDF: informe del proyecto con planos y presupuesto -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.5</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- @{argLine} recibe el agente de JaCoCo (cobertura) -->
          <argLine>@{argLine} ${native.access} -Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <!-- Falla pronto y con un mensaje claro si se compila con un Java o Maven muy viejo -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>versiones-minimas</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>Amoblador3D necesita el JDK 21 o superior (https://adoptium.net).</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Cobertura de pruebas: mvnw verify  ->  target/site/jacoco/index.html -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>informe</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- La compilación falla si las reglas del programa quedan con pocas pruebas.
               La interfaz (ui, scene) y el arranque se prueban a mano: no entran en la regla. -->
          <execution>
            <id>cobertura-minima</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>pe.edu.unaj.amoblador3d.model</include>
                    <include>pe.edu.unaj.amoblador3d.design</include>
                    <include>pe.edu.unaj.amoblador3d.estimate</include>
                    <include>pe.edu.unaj.amoblador3d.catalog</include>
                    <include>pe.edu.unaj.amoblador3d.persistence</include>
                    <include>pe.edu.unaj.amoblador3d.report</include>
                    <include>pe.edu.unaj.amoblador3d.gltf</include>
                    <include>pe.edu.unaj.amoblador3d.util</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- mvnw javafx:run  ->  abre la aplicación -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <option>${native.access}</option>
          </options>
        </configuration>
      </plugin>

      <!-- mvnw package  ->  target/amoblador3d.jar con todas las dependencias -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>amoblador3d</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                  <manifestEntries>
                    <Implementation-Title>${project.name}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
